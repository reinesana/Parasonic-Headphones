# Spotify app from https://developer.spotify.com/dashboard (Web API, redirect URI below)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# sp_dc cookie from a logged-in open.spotify.com session (DevTools > Application > Cookies)
SP_DC=

# optional
POLL_SECONDS=3
PREFETCH=2
PORT=8787
